; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Hearth & Furrow"
run/main_scene="uid://dkaf0otbgtrp5"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://ci8u0m7y1ts8a"

[autoload]

Content="*res://scripts/autoload/content.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Progress="*res://scripts/autoload/progress.gd"
GameClock="*res://scripts/autoload/game_clock.gd"
Calendar="*res://scripts/autoload/calendar.gd"
Weather="*res://scripts/autoload/weather.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Economy="*res://scripts/autoload/economy.gd"
Relationships="*res://scripts/autoload/relationships.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="HearthAndFurrow"

[file_customization]

folder_colors={
"res://audio/": "pink",
"res://graphics/": "purple",
"res://graphics/Ninja Adventure - Asset Pack/": "pink",
"res://graphics/Sprout Lands - Sprites - Basic pack/Sprout Lands - Sprites - Basic pack/Tilesets/": "pink",
"res://graphics/Tiny Swords/Tiny Swords (Update 010)/Deco/": "pink",
"res://graphics/characters/": "pink",
"res://graphics/plants/": "pink",
"res://graphics/ui/": "pink",
"res://graphics/weather/": "pink",
"res://scenes/": "green",
"res://scripts/": "blue",
"res://shaders/": "gray"
}

[gui]

theme/custom="res://scenes/ui/game_theme.tres"

[global_group]

Objects=""
Sword_able=""
Axe_able=""
Player=""

